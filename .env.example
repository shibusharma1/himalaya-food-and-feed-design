# Himalayan Food and Feed - Environment Configuration Template
# Copy to .env or configure directly in your cPanel / Apache VirtualHost environment

APP_NAME="Himalayan Food and Feed"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.himalayanfoodandfeed.com

# Mail Configuration
# Mode options:
#   'auto'    - Uses native PHP mail() in production, safe logging in local dev
#   'mail'    - Force PHP native mail() function
#   'dev_log' - Simulated delivery (writes sanitized logs to storage/logs/enquiries.log)
MAIL_MODE=auto
MAIL_RECIPIENT=kumar@himalayanfoodandfeed.com
MAIL_SENDER=no-reply@himalayanfoodandfeed.com

# SMTP Optional Parameters (for custom external mailers)
# SMTP_HOST=mail.himalayanfoodandfeed.com
# SMTP_PORT=587
# SMTP_USERNAME=kumar@himalayanfoodandfeed.com
# SMTP_PASSWORD=your_secure_password_here
# SMTP_ENCRYPTION=tls
