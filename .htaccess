# ==============================================================================
# Himalayan Food and Feed - Apache Web Server Configuration (.htaccess)
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Custom 404 handler
    ErrorDocument 404 /404.php

    # Block access to hidden files and directories (e.g. .git, .env)
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # Block access to private storage, logs, and development files
    RewriteRule ^storage/.*$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^\.git.*$ - [F,L]
    RewriteRule ^.*\.log$ - [F,L]

    # Support clean URLs by mapping extensionless requests to .php files if they exist
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Ensure UTF-8 default
    AddDefaultCharset UTF-8
</IfModule>

# Browser Caching and Static Asset Optimization
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
